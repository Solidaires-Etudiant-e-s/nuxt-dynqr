# Copy to .env and fill in. Never commit the real .env.

# --- Database (MariaDB/MySQL via Prisma) ---
DATABASE_URL="mysql://USER:PASS@HOST:3306/DBNAME"

# --- LDAP + local dev SSO emulation ---
LDAP_URL="ldap://127.0.0.1:10389"
EMULATE_SSOWAT="true"              # only for local dev
EMULATE_SSOWAT_UID="devuser"       # only for local dev
EMULATE_SSOWAT_PWD="devpassword"   # only for local dev
EMULATE_DYNAMICQRCODE="false"      # emulate former Dynamic QR code yunohost app redirects

# --- Umami analytics ---
UMAMI="my-w3b517e-id"
